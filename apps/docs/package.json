{
	"name": "apps-docs",
	"type": "module",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "astro dev",
		"build": "rm -rf ./dist && astro build && mv ./dist/docs/_redirects ./dist/_redirects && mv ./dist/docs/_headers ./dist/_headers && pagefind --site ./dist/docs",
		"preview": "astro preview",
		"deploy": "pnpm run build && pnpm exec wrangler deploy",
		"astro": "astro",
		"check:types": "tsc --noEmit",
		"lint:docs": "nimbus-docs lint",
		"lint:docs:fix": "nimbus-docs lint --fix"
	},
	"dependencies": {
		"@cloudflare/nimbus-docs": "^0.10.0",
		"@fontsource-variable/inter": "^5.2.8",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@iconify-json/ph": "^1.2.0",
		"astro": "~7.0.9",
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.5.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.2.0",
		"pagefind": "^1.5.2",
		"tailwindcss": "^4.2.0",
		"typescript": "^7.0.2",
		"vite": "^8.0.14",
		"wrangler": "^4.113.0"
	}
}
