---
import { Icon } from "astro-icon/components";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import { SearchTrigger } from "./ui/search";
import SectionNav from "./SectionNav.astro";
import { config } from "virtual:nimbus/config";
import { getNavSections } from "@/lib/nav-sections";

interface Props {
  collection?: string;
  entryId?: string;
  showSidebar?: boolean;
  variant?: "page" | "dialog";
}

const { collection, showSidebar = true, variant = "page" } = Astro.props;
const isDialog = variant === "dialog";

const sections = isDialog ? [] : await getNavSections(Astro.url.pathname, collection);
const showSections = sections.length >= 2;

const Wrapper = isDialog ? "div" : "header";
const wrapperClass = isDialog
  ? "shrink-0 border-b border-border bg-card"
  : "sticky top-0 z-30 border-b border-border bg-card/80 backdrop-blur-lg";
---

<Wrapper class={wrapperClass}>
  <div class="mx-auto flex items-center justify-between gap-2 h-14 px-4 lg:px-6">
    <div class="flex min-w-0 items-center gap-8">
      <a href="https://flueframework.com" class="flex min-w-0 items-center gap-2" aria-label={`${config.title} homepage`}>
        <svg class="size-5 shrink-0" viewBox="0 0 108 108" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <rect width="108" height="108" transform="matrix(-1 0 0 1 108 0)" class="fill-foreground" />
          <rect width="18" height="18" transform="matrix(-1 0 0 1 72 18)" class="fill-card" />
          <rect width="18" height="18" transform="matrix(-1 0 0 1 54 72)" class="fill-card" />
          <rect width="18" height="18" transform="matrix(-1 0 0 1 54 36)" class="fill-card" />
          <rect width="18" height="18" transform="matrix(-1 0 0 1 72 54)" class="fill-card" />
        </svg>
        <span class="truncate text-lg font-bold tracking-tight text-foreground leading-none">
          {config.title}
        </span>
      </a>

      {showSections && <SectionNav sections={sections} class="hidden md:flex" />}
    </div>

    <div class="flex shrink-0 items-center gap-2">
      {config.search !== false && <SearchTrigger />}
      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      <ThemeToggle />
      {isDialog ? (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:x"
          aria-label="Close navigation"
          data-close-sidebar
          class="text-muted-foreground"
        />
      ) : (
        showSidebar && (
          <Button
            variant="ghost"
            shape="square"
            size="sm"
            icon="ph:list"
            aria-label="Open navigation"
            data-menu-btn
            class="lg:hidden text-muted-foreground"
          />
        )
      )}
    </div>
  </div>
</Wrapper>
