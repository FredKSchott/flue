---
/**
 * SidebarGroup — static (non-collapsible) section header plus its links.
 *
 * Group titles render as non-interactive section headers separated by
 * spacing (Flue parity); a group that owns a landing page renders its
 * label as a link. No caret, nothing collapses — the rail is a flat,
 * always-open set of grouped sections.
 */
import { Icon } from "astro-icon/components";
import { cn } from "@/lib/cn";
import { withBase } from "@/lib/with-base";
import type { HTMLAttributes } from "astro/types";
import SidebarLink from "./SidebarLink.astro";
import { Badge } from "@/components/ui/badge";
import type { SidebarItem, SidebarBadge } from "@cloudflare/nimbus-docs/types";

interface Props extends HTMLAttributes<"div"> {
  label: string;
  items: SidebarItem[];
  collapsed?: boolean;
  badge?: SidebarBadge;
  indexHref?: string;
  indexIsCurrent?: boolean;
  indexIsExternal?: boolean;
  icon?: string;
}

const {
  label,
  items,
  collapsed,
  badge,
  indexHref,
  indexIsCurrent,
  indexIsExternal,
  icon,
  class: className,
  ...attrs
} = Astro.props;

const headingClass =
  "mb-1 flex items-center gap-2 px-3 text-[0.875rem] font-semibold text-sidebar-heading";
---

<section
  class={cn("pb-4 [&:not(:first-child)]:pt-2", className)}
  {...attrs}
>
  {indexHref ? (
    <a
      href={withBase(indexHref)}
      aria-current={indexIsCurrent ? "page" : undefined}
      target={indexIsExternal ? "_blank" : undefined}
      rel={indexIsExternal ? "noopener" : undefined}
      class={cn(
        headingClass,
        "no-underline transition-colors hover:text-foreground",
        indexIsCurrent && "text-foreground",
      )}
    >
      {icon && <Icon name={icon} class="h-4 w-4 shrink-0 text-muted-foreground" />}
      <span class="break-words">{label}</span>
      {badge &&
        (typeof badge === "string" ? (
          <Badge text={badge} />
        ) : (
          <Badge text={badge.text} variant={badge.variant} />
        ))}
    </a>
  ) : (
    <div class={headingClass}>
      {icon && <Icon name={icon} class="h-4 w-4 shrink-0 text-muted-foreground" />}
      <span class="break-words">{label}</span>
      {badge &&
        (typeof badge === "string" ? (
          <Badge text={badge} />
        ) : (
          <Badge text={badge.text} variant={badge.variant} />
        ))}
    </div>
  )}

  <ul class="mt-0.5 flex list-none flex-col gap-px p-0">
    {items.map((item) => (
      <li class="break-words">
        {item.type === "group" ? (
          <Astro.self
            label={item.label}
            items={item.children}
            collapsed={collapsed}
            badge={item.badge}
            icon={item.icon}
            indexHref={item.indexHref}
            indexIsCurrent={item.indexIsCurrent}
            indexIsExternal={item.indexIsExternal}
          />
        ) : item.type === "external" ? (
          <SidebarLink label={item.label} href={item.href} badge={item.badge} target="_blank" rel="noopener" />
        ) : (
          <SidebarLink label={item.label} href={item.href} isCurrent={item.isCurrent} badge={item.badge} />
        )}
      </li>
    ))}
  </ul>
</section>
