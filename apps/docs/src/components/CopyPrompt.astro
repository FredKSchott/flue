---
import { Button } from "./ui/button";

interface Props {
	text: string;
}

const { text } = Astro.props;
---

<div
	class="not-prose my-6 flex flex-col gap-3 rounded-xl border border-link/30 bg-link/5 p-3 sm:flex-row sm:items-center sm:gap-4"
	data-copy-prompt
>
	<p class="m-0 min-w-0 flex-1 truncate text-xs text-foreground">
		<span data-copy-prompt-text>{text}</span>
	</p>
	<Button
		variant="primary"
		size="sm"
		class="w-full shrink-0 bg-link text-white hover:bg-link/90 sm:w-auto"
		aria-label="Copy prompt"
	>
		<span class="grid justify-items-center">
			<span class="col-start-1 row-start-1" data-copy-prompt-idle>Copy Prompt</span>
			<span class="invisible col-start-1 row-start-1" data-copy-prompt-done aria-hidden="true">Copied!</span>
		</span>
	</Button>
</div>

<style is:global>
	/* In dark mode --nb-link is a lighter blue, so switch the button label to
	   near-black (the dark surface color) for stronger contrast. */
	[data-mode="dark"] [data-copy-prompt] button {
		color: var(--nb-background);
	}
</style>

<script>
	for (const prompt of document.querySelectorAll<HTMLElement>('[data-copy-prompt]')) {
		const button = prompt.querySelector<HTMLButtonElement>('button');
		const code = prompt.querySelector<HTMLElement>('[data-copy-prompt-text]');
		const idle = prompt.querySelector<HTMLElement>('[data-copy-prompt-idle]');
		const done = prompt.querySelector<HTMLElement>('[data-copy-prompt-done]');
		if (!button || !code) continue;
		let timer: ReturnType<typeof setTimeout>;
		button.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(code.textContent ?? '');
				if (idle && done) {
					idle.classList.add('invisible');
					done.classList.remove('invisible');
					done.setAttribute('aria-hidden', 'false');
					clearTimeout(timer);
					timer = setTimeout(() => {
						done.classList.add('invisible');
						done.setAttribute('aria-hidden', 'true');
						idle.classList.remove('invisible');
					}, 2000);
				}
			} catch {
				/* clipboard unavailable */
			}
		});
	}
</script>
